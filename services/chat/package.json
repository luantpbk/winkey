    "fastify": "^5.12.7",
    "ioredis": "^5.6.0",
    "kysely": "^0.29.7",
    "nats": "^2.29.3",
    "pg": "^8.23.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.18.0",
