# Winkey chat-svc Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
HTTP_PORT=8003

# PostgreSQL connection string (chat_svc role)
DATABASE_URL=postgres://chat_svc:chat_svc@localhost:5432/winkey?sslmode=disable

# NATS server URL (Core NATS publish rt.chat.user.*)
NATS_URL=nats://localhost:4222

# Valkey / Redis URL for rate limiting and distributed purge lock
VALKEY_URL=redis://localhost:6379

# Base URL for public media CDN (avatars)
MEDIA_BASE_URL=https://media.winkey.vn

# Comma-separated list of trusted proxy CIDRs (Traefik, loopback)
TRUST_PROXY_CIDRS=10.42.0.0/16,127.0.0.1

# Purge job interval for to-device messages (e.g. 1h, 60m, 3600s)
TO_DEVICE_PURGE_INTERVAL=1h
