# Dummy values for local development only. Never commit real secrets.
HTTP_ADDR=:8081
LOG_LEVEL=info
NATS_URL=nats://localhost:4222
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
# db/clickhouse/*.sql of the repository, applied at start-up.
CLICKHOUSE_MIGRATIONS_DIR=../../db/clickhouse
BATCH_MAX_MESSAGES=5000
BATCH_MAX_WAIT=2s
CLICKHOUSE_INSERT_TIMEOUT=30s
# Daily rollup into PostgreSQL (task R1-b).
ROLLUP_ENABLED=true
POSTGRES_URL=postgres://analytics_svc:analytics_svc@localhost:5432/winkey?sslmode=disable
ROLLUP_INTERVAL=10m
ROLLUP_WINDOW_DAYS=3
ROLLUP_BACKFILL_DAYS=8
# Recommendation projections (task R2-w).
RECO_ENABLED=true
RECO_INTERVAL=30m
RECO_WINDOW_DAYS=30
RECO_MIN_WATCH_MS=20000
RECO_NEIGHBORS=30
RECO_HISTORY=50
