# Environment variables for auth-svc
# Rule 5: Dummy values only. No secrets in git.

NODE_ENV=development
HTTP_PORT=8001

# PostgreSQL connection string (must use auth_svc database role)
DATABASE_URL=postgres://auth_svc:auth_svc@localhost:5432/winkey?sslmode=disable

# NATS JetStream URL
NATS_URL=nats://localhost:4222

# Valkey (Redis) URL for rate limiting
VALKEY_URL=redis://localhost:6379

# JWT Signing Key (RS256 Private Key in PEM format)
# Generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC6dummy...\n-----END PRIVATE KEY-----"
JWT_KID=winkey-auth-key-1

# Optional previous public key for smooth 24-hour key rotation
JWT_PREVIOUS_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAu8dummy...\n-----END PUBLIC KEY-----"

# Issuer claim (iss)
JWT_ISSUER=https://winkey.vn

# Public site origin (for refresh & logout Origin header validation)
PUBLIC_ORIGIN=https://winkey.vn

# Base URL for user avatar assets
MEDIA_BASE_URL=https://media.winkey.vn

# Google OAuth Credentials
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret
GOOGLE_REDIRECT_URI=https://winkey.vn/v1/auth/oauth/google/callback

# Secret used to sign temporary OAuth session cookies
COOKIE_SECRET=dummy-cookie-signing-secret-minimum-32-chars
