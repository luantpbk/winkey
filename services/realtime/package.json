{
  "name": "@winkey/realtime",
  "version": "1.0.0",
  "description": "Winkey realtime gateway service (WebSocket rooms & events)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "dev": "node --loader ts-node/esm src/index.ts",
    "test": "vitest run",
    "test:prod-deps": "node ../../packages/outbox/scripts/test-prod-deps.mjs @winkey/realtime"
  },
  "dependencies": {
    "@winkey/metrics": "workspace:*",
    "@winkey/outbox": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "nats": "^2.29.3",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "uuid": "^11.1.0",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.5.14",
    "testcontainers": "^10.18.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.2",
    "yaml": "^2.7.0"
  }
}
