# Dummy values for local development only. Never commit real secrets.
HTTP_ADDR=:8080
LOG_LEVEL=info
DATABASE_URL=postgres://media_svc:media_svc@localhost:5432/winkey?sslmode=disable
NATS_URL=nats://localhost:4222

# Object keys are turned into URLs with this prefix (playback, thumbnails, avatars).
MEDIA_BASE_URL=http://localhost:8080/media
# Bucket named in video.deleted events (the transcoder's media janitor purges it).
S3_MEDIA_BUCKET=winkey-media

# Signs media URLs of videos the public cannot watch (private, hidden, not ready). At least 32 bytes.
# The same value is configured in the nginx of media.winkey.vn (ADR-017). Never log or commit the real one.
MEDIA_LINK_SECRET=dev-only-media-link-secret-0123456789abcdef

# Signs pagination cursors so tampering is detected. At least 16 characters; keep it
# identical across replicas, and note that changing it invalidates outstanding cursors.
CURSOR_SECRET=dev-only-change-me-0123456789

# Optional GET /v1/videos/{id} cache. Empty = disabled.
# VALKEY_URL=redis://localhost:6379/0
CACHE_TTL=30s

# View counter (POST /v1/videos/{id}/views). Needs VALKEY_URL; without it views are not counted.
# Peers allowed to set X-Forwarded-For (the gateway); anything else is ignored.
TRUST_PROXY_CIDRS=10.42.0.0/16,127.0.0.1
VIEW_RATE_LIMIT=60
VIEW_DEDUP_TTL=30m
VIEW_FLUSH_INTERVAL=30s
VIEW_FLUSH_LOCK_TTL=2m

# Optional: tracing is a no-op when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
