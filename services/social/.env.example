# Winkey social-svc Environment Configuration
# Copy this file to .env for local development

NODE_ENV=development
HTTP_PORT=8002

# PostgreSQL connection string (social_svc role)
DATABASE_URL=postgres://social_svc:social_svc@localhost:5432/winkey?sslmode=disable

# NATS JetStream server URL
NATS_URL=nats://localhost:4222

# Valkey / Redis URL for rate limiting
VALKEY_URL=redis://localhost:6379

# Base URL for public media CDN (avatars, thumbnails)
MEDIA_BASE_URL=https://media.winkey.vn

# Comma-separated list of trusted proxy CIDRs (Traefik, loopback)
TRUST_PROXY_CIDRS=10.42.0.0/16,127.0.0.1
