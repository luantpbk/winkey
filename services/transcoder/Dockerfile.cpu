# transcoder-cpu: linux/amd64 + linux/arm64, x264 only. Build context: the repository root.
#   docker buildx build --platform linux/amd64,linux/arm64 -f services/transcoder/Dockerfile.cpu .
FROM --platform=$BUILDPLATFORM golang:1.26 AS build
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY libs/go/go.mod libs/go/go.sum libs/go/
COPY services/transcoder/go.mod services/transcoder/go.sum services/transcoder/
RUN cd services/transcoder && go mod download
COPY libs/go libs/go
COPY services/transcoder services/transcoder
RUN cd services/transcoder && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/transcoder ./cmd/transcoder \
 && CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath -ldflags="-s -w" -o /out/replay-dlq ./cmd/replay-dlq

# FFmpeg pinned to a dated BtbN FFmpeg-Builds release (static GPL, libx264), the same build
# as Dockerfile.nvenc: FFmpeg n7.1.5-12-g1fdbca85aa, release autobuild-2026-07-31-14-10
# (linux64 for amd64, linuxarm64 for arm64). Archives are verified with sha256sum -c; to
# bump, update the release/archive/checksums here and in Dockerfile.nvenc (checksums are in
# the release's checksums.sha256) and the README.
FROM debian:12-slim AS ffmpeg
ARG TARGETARCH
ARG FFMPEG_RELEASE=autobuild-2026-07-31-14-10
ARG FFMPEG_AMD64=ffmpeg-n7.1.5-12-g1fdbca85aa-linux64-gpl-7.1.tar.xz
ARG FFMPEG_AMD64_SHA256=c1e6caf48923dd8e6bc5e54d51ba70c321175b8162ae9c414c392990e72f0e79
ARG FFMPEG_ARM64=ffmpeg-n7.1.5-12-g1fdbca85aa-linuxarm64-gpl-7.1.tar.xz
ARG FFMPEG_ARM64_SHA256=a9a50c5782ef5e45306d58d1a9a819015b472d8da30ab6a77f15f571c861a71b
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils \
 && rm -rf /var/lib/apt/lists/*
RUN case "$TARGETARCH" in \
      amd64) ARCHIVE="$FFMPEG_AMD64"; SHA="$FFMPEG_AMD64_SHA256";; \
      arm64) ARCHIVE="$FFMPEG_ARM64"; SHA="$FFMPEG_ARM64_SHA256";; \
      *) echo "unsupported TARGETARCH $TARGETARCH" >&2; exit 1;; esac \
 && curl -fsSL "https://github.com/BtbN/FFmpeg-Builds/releases/download/${FFMPEG_RELEASE}/${ARCHIVE}" -o /tmp/ffmpeg.tar.xz \
 && echo "${SHA}  /tmp/ffmpeg.tar.xz" | sha256sum -c - \
 && mkdir /ffmpeg && tar -xJf /tmp/ffmpeg.tar.xz -C /ffmpeg --strip-components=2 --wildcards '*/bin/ffmpeg' '*/bin/ffprobe'

FROM debian:12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home --home-dir /home/transcoder transcoder \
 && mkdir -p /scratch /archive && chown transcoder /scratch /archive
COPY --from=ffmpeg /ffmpeg/ffmpeg /ffmpeg/ffprobe /usr/local/bin/
COPY --from=build /out/transcoder /out/replay-dlq /usr/local/bin/
ENV ENCODER=x264 \
    SCRATCH_DIR=/scratch \
    FFMPEG_PATH=/usr/local/bin/ffmpeg \
    FFPROBE_PATH=/usr/local/bin/ffprobe
USER transcoder
EXPOSE 8081
ENTRYPOINT ["/usr/local/bin/transcoder"]
