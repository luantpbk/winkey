# /etc/winkey/transcoder.env on gpu-01 (root:root, mode 0600). Every value below is a
# placeholder: copy this file, then fill in the real ones. Never commit the real file.
#
# A unit test keeps the keys of this file identical to the `env:` tags of
# services/transcoder/internal/config/config.go, and checks that the file loads as a
# valid configuration.
# systemd reads this file itself (EnvironmentFile=): use plain KEY=value lines, no
# `export`, no shell expansion.

# --- Where the worker listens (health, readiness, Prometheus metrics) ---------------
# Bind loopback (or the tailnet IP of gpu-01), never 0.0.0.0 and never a bare ":8081"
# (that means all interfaces).
HTTP_ADDR=127.0.0.1:8081
LOG_LEVEL=info

# --- edge-1 over Tailscale (ADR-015): fixed NodePorts, tailnet IP only -------------
# NATS 30422 / PostgreSQL (Winkey, role media_svc) 30432 / Garage S3 30900. The
# addresses below are fake; use edge-1's Tailscale IP. Never point this at the host
# PostgreSQL on 5432.
DATABASE_URL=postgres://media_svc:CHANGE_ME@100.64.0.10:30432/winkey?sslmode=disable
NATS_URL=nats://100.64.0.10:30422
S3_ENDPOINT=http://100.64.0.10:30900
S3_REGION=garage
S3_ACCESS_KEY_ID=GK000000000000000000000000
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_RAW_BUCKET=winkey-raw
S3_MEDIA_BUCKET=winkey-media

# --- Encoding: gpu-01 has an RTX 5060 Ti shared with a miner and ComfyUI --------------
ENCODER=nvenc
# x264 preset when the worker falls back to (or is set to) x264.
X264_PRESET=veryfast
# With the GPU shared, NVDEC decode measured ~2x slower than CPU decode (3.0x vs 5.6x
# realtime), and one job already saturates NVENC: hence CPU decode and one job at a time
# (docs/INFRASTRUCTURE.md section 6).
HWACCEL_DECODE=false
WORKER_CONCURRENCY=1
# gpu-01: 16 parallel R2 PUTs hide ~0.77 s per-PUT latency.
UPLOAD_PARALLELISM=16

# --- Paths --------------------------------------------------------------------------
# Scratch on the fast NVMe, archive on the HDD. These two paths are also listed in the
# unit's ReadWritePaths= (systemd cannot read them from here): change both together.
SCRATCH_DIR=/mnt/nvme_models/winkey/scratch
ARCHIVE_DIR=/mnt/hdd_storage/winkey/archive
# Absolute paths, never PATH: FFmpeg n7.1.5 (BtbN autobuild-2026-07-31-14-10) with NVENC.
FFMPEG_PATH=/opt/ffmpeg-7.1/bin/ffmpeg
FFPROBE_PATH=/opt/ffmpeg-7.1/bin/ffprobe

# --- Shutdown and recovery ------------------------------------------------------------
# Running jobs get this long after SIGTERM; then they are cancelled and handed back to
# the queue. The unit's TimeoutStopSec must be this + 30 s (60 s for 30 s).
SHUTDOWN_GRACE=30s
# Stuck-job reconciler: a RUNNING job with no heartbeat for STALE_JOB_AFTER is retried
# (up to MAX_JOB_ATTEMPTS attempts), then failed.
RECONCILE_INTERVAL=60s
STALE_JOB_AFTER=10m
MAX_JOB_ATTEMPTS=3

# Optional (read by libs/go/obs, not part of the config struct): tracing is a no-op when unset.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://100.64.0.10:4318
