{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": []
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": [],
      "env": ["WINKEY_REQUIRE_DOCKER", "TEST_DATABASE_URL", "TEST_NATS_URL"],
      "passThroughEnv": ["DOCKER_HOST", "TESTCONTAINERS_*"]
    }
  }
}
