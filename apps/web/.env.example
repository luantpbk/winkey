# Winkey Web Environment Variables
PORT=3000
NODE_ENV=development

# Server-side internal API URL (SSR / RSC). Dev: Traefik at http://localhost:8080; Prod: set by Helm
API_INTERNAL_URL=http://localhost:8080

# Client-side API URL (browser). Leave empty for same-origin proxy or set to Traefik gateway
NEXT_PUBLIC_API_URL=http://localhost:8080

# Enable MSW mock service worker in development/testing (1 = enabled, 0 = disabled)
API_MOCKS=1
NEXT_PUBLIC_API_MOCKS=1

# Media CDN base URL for HLS streaming segments
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.winkey.vn
