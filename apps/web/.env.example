# Winkey Web Environment Variables
PORT=3000
NODE_ENV=development

# Set to 1 to enable MSW mock service worker in development/testing without real backend APIs
NEXT_PUBLIC_API_MOCKS=1

# Production / Gateway API origin (in local dev Traefik is http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Media CDN base URL for HLS streaming segments
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.winkey.vn
