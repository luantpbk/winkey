{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winkey.vn/contracts/realtime/server.schema.json",
  "title": "realtime-gw server → client message",
  "description": "Text frame sent by realtime-gw on /v1/realtime. See contracts/realtime/README.md.",
  "oneOf": [
    {
      "$ref": "#/$defs/welcome"
    },
    {
      "$ref": "#/$defs/ack"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/pong"
    },
    {
      "$ref": "#/$defs/event"
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "welcome": {
      "type": "object",
      "required": [
        "type",
        "connection_id",
        "user_id",
        "heartbeat_interval_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "welcome"
        },
        "connection_id": {
          "$ref": "#/$defs/uuid"
        },
        "user_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "heartbeat_interval_ms": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "ack": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "ack"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "type",
        "id",
        "code",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error"
        },
        "id": {
          "oneOf": [
            {
              "$ref": "#/$defs/requestId"
            },
            {
              "type": "null"
            }
          ]
        },
        "code": {
          "enum": [
            "BAD_MESSAGE",
            "ROOM_INVALID",
            "ROOM_FORBIDDEN",
            "AUTH_REQUIRED",
            "TOO_MANY_ROOMS",
            "RATE_LIMITED"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "pong": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pong"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        }
      }
    },
    "event": {
      "type": "object",
      "required": [
        "type",
        "room",
        "event",
        "data",
        "ts"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "event"
        },
        "room": {
          "type": "string",
          "pattern": "^(video|upload|user):[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "event": {
          "enum": [
            "video.progress",
            "video.ready",
            "video.failed",
            "comment.created",
            "comment.reply",
            "like.count"
          ]
        },
        "data": {
          "type": "object"
        },
        "ts": {
          "type": "string",
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "event": {
                "const": "video.progress",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^upload:",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/videoProgress"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "video.ready",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^(upload|user):",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/videoReady"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "video.failed",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^(upload|user):",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/videoFailed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "comment.created",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^video:",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/commentRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "comment.reply",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^user:",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/commentRef"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "event": {
                "const": "like.count",
                "type": "string"
              }
            },
            "required": [
              "event"
            ]
          },
          "then": {
            "properties": {
              "room": {
                "pattern": "^video:",
                "type": "string"
              },
              "data": {
                "$ref": "#/$defs/likeCount"
              }
            }
          }
        }
      ]
    },
    "videoProgress": {
      "type": "object",
      "required": [
        "video_id",
        "stage",
        "percent"
      ],
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "$ref": "#/$defs/uuid"
        },
        "stage": {
          "enum": [
            "DOWNLOADING",
            "PROBING",
            "TRANSCODING",
            "UPLOADING"
          ]
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "videoReady": {
      "type": "object",
      "required": [
        "video_id"
      ],
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "videoFailed": {
      "type": "object",
      "required": [
        "video_id",
        "reason",
        "message",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "$ref": "#/$defs/uuid"
        },
        "reason": {
          "enum": [
            "INVALID_INPUT",
            "TIMEOUT",
            "ENCODER_ERROR",
            "STORAGE_ERROR",
            "INTERNAL"
          ],
          "description": "Copied from video.failed data.reason."
        },
        "message": {
          "type": "string",
          "description": "Owner-facing fixed string from video.failed."
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "commentRef": {
      "type": "object",
      "required": [
        "comment_id",
        "video_id",
        "parent_id"
      ],
      "additionalProperties": false,
      "properties": {
        "comment_id": {
          "$ref": "#/$defs/uuid"
        },
        "video_id": {
          "$ref": "#/$defs/uuid"
        },
        "parent_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "likeCount": {
      "type": "object",
      "required": [
        "video_id",
        "like_count"
      ],
      "additionalProperties": false,
      "properties": {
        "video_id": {
          "$ref": "#/$defs/uuid"
        },
        "like_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
