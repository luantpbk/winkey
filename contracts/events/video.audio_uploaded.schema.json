{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://winkey.vn/contracts/events/video.audio_uploaded.schema.json",
  "title": "video.audio_uploaded v1",
  "description": "An extra audio track (task MUX1, ADR-042) is fully uploaded; the audio-only encode may start. Producer: upload-svc. Consumer: transcoder.",
  "type": "object",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "video.audio_uploaded" },
    "version": { "const": 1 },
    "data": {
      "type": "object",
      "required": ["video_id", "owner_id", "track_id", "lang", "kind", "raw_bucket", "raw_key", "size_bytes", "content_type"],
      "additionalProperties": false,
      "properties": {
        "video_id": { "type": "string", "format": "uuid" },
        "owner_id": { "type": "string", "format": "uuid" },
        "track_id": { "type": "string", "format": "uuid" },
        "lang": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
        "kind": { "enum": ["original", "dub", "voiceover", "commentary"] },
        "raw_bucket": { "type": "string" },
        "raw_key": { "type": "string" },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "content_type": { "type": "string" }
      }
    }
  }
}
