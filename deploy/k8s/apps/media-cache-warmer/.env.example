# Media Cache Warmer Configuration
# Base URLs
MEDIA_BASE_URL=https://media.winkey.vn
API_BASE_URL=https://winkey.vn

# QoS and Concurrency
MAX_CONCURRENCY=4
RATE_LIMIT_BPS=5242880 # 5 MB/s global token bucket across all workers

# Budget and Scopes
WARM_MAX_BYTES_PER_RUN=3221225472 # 3 GiB run budget
WARM_SEGMENTS_COUNT=15 # First 15 segments (~60s) of every rendition
HOT_FULL_LIMIT=5       # Top 5 trending videos get full 720p from H.264 master
HOT_VIDEOS_LIMIT=20    # Trending videos to evaluate
NEW_VIDEOS_HOURS=24    # Videos published in the last 24 hours
