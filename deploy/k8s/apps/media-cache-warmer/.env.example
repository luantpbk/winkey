# Media Cache Warmer Configuration
# Base URLs
MEDIA_BASE_URL=https://media.winkey.vn
API_BASE_URL=https://winkey.vn

# Cache Disk Guard
CACHE_DIR=/nginx-cache
MAX_CACHE_BYTES=42949672960 # 40GB (guard stops at 80% = 32GB)

# QoS and Concurrency
MAX_CONCURRENCY=4
RATE_LIMIT_BPS=5242880 # 5 MB/s

# Scopes
WARM_SEGMENTS_COUNT=15 # First 15 segments (~60s) of every rendition
HOT_VIDEOS_LIMIT=20    # Top 20 trending videos get full 720p + default audio
NEW_VIDEOS_HOURS=24    # Videos published in the last 24 hours

# Optional Signed URLs Secret (SEC1-b / ADR-017)
MEDIA_LINK_SECRET=dummy_media_secret_never_commit_real_secret
