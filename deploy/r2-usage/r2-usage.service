[Unit]
Description=Cloudflare R2 Usage & Cost Prometheus Exporter (ADR-032 / INF-R2b)
After=network.target

[Service]
Type=simple
User=winkey
Group=winkey
EnvironmentFile=-/etc/winkey/r2-usage.env
ExecStart=/usr/bin/python3 /opt/winkey/scripts/r2_usage_exporter.py
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
