# ClickHouse winkey user password (generate with: openssl rand -hex 16)
CLICKHOUSE_PASSWORD=replace-with-secure-clickhouse-password

# NATS credentials for analytics user on edge-1
# Retrieve on edge-1 with: kubectl get secret nats-auth -n default -o jsonpath='{.data.analytics_password}' | base64 -d
NATS_ANALYTICS_PASSWORD=replace-with-edge-1-nats-analytics-password

# NATS URL to edge-1 NodePort over Tailscale (100.113.240.3:30422)
NATS_URL=nats://analytics:${NATS_ANALYTICS_PASSWORD}@100.113.240.3:30422

# ClickHouse native DSN for analytics-worker
CLICKHOUSE_DSN=clickhouse://winkey:${CLICKHOUSE_PASSWORD}@127.0.0.1:9000/winkey

# Path to db/clickhouse migrations directory (mounted read-only)
MIGRATIONS_PATH=../../../db/clickhouse

# PostgreSQL connection to edge-1 NodePort over Tailscale (100.113.240.3:30432) for R1-b creator stats rollup
# Retrieve analytics_svc password on edge-1 with: kubectl get secret winkey-pg-analytics-svc -n default -o jsonpath='{.data.password}' | base64 -d
POSTGRES_URL=postgres://analytics_svc:replace-with-edge-1-analytics-svc-password@100.113.240.3:30432/winkey?sslmode=require

# Analytics worker image pinned by digest from CI build (never use :latest)
# e.g. ghcr.io/luantpbk/winkey-analytics-worker@sha256:<digest-from-ci>
ANALYTICS_WORKER_IMAGE=ghcr.io/luantpbk/winkey-analytics-worker@sha256:replace-with-pinned-digest-from-ci


