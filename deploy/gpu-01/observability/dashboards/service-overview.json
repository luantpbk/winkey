          "calcs": ["mean", "max", "lastNotNull"]
        }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "victoriametrics" },
          "editorMode": "code",
          "expr": "sum by (app) (rate(http_requests_total{status=~\"5..\"}[1m])) / clamp_min(sum by (app) (rate(http_requests_total[1m])), 0.001)",
          "legendFormat": "{{app}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "5xx Error Rate by Service",
      "type": "timeseries"
    },
