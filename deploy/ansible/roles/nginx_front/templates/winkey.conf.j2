# Managed by Ansible (deploy/ansible/roles/nginx_front). Local edits are overwritten.
# Winkey hosts on the shared host nginx -> Traefik (k3s NodePort on the tailnet IP).

# Edge media caching zone on host disk (ADR-005, ADR-014)
# Max 10 GB disk cache on /, keys in memory (10m zone ~ 80,000 keys)
proxy_cache_path /var/cache/nginx/winkey-media levels=1:2 keys_zone=winkey_media:10m max_size=10g inactive=30d use_temp_path=off;

# Internal media access auth caching zone (ADR-017, SEC1-b)
# 10m zone (~80,000 video IDs), inactive 10m
proxy_cache_path /var/cache/nginx/winkey-media-auth levels=1:2 keys_zone=winkey_media_auth:10m max_size=100m inactive=10m use_temp_path=off;

upstream winkey_traefik {
    server {{ tailscale_ipv4 }}:{{ traefik_nodeport_web }};
    keepalive 32;
}

map $http_upgrade $winkey_connection {
    default upgrade;
    ''      '';
}

# --- HTTP (Port 80) ---
server {
    listen 80;
    server_name {{ nginx_front.hosts | join(' ') }};

{% if with_tls | bool %}
    location / {
        return 301 https://$host$request_uri;
    }
{% else %}
    # Until the certificate exists: certbot adds its challenge location here temporarily.
    location / {
        return 404;
    }
{% endif %}
}

{% if with_tls | bool %}
# --- HTTPS (Port 443) ---

# Default server block: reject unknown hosts, direct IP access, and unrouted SNI on 443
server {
    listen 443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}

# 1. Main site: web app & API /v1/*
server {
    listen 443 ssl http2;
    server_name winkey.vn www.winkey.vn;

    ssl_certificate /etc/letsencrypt/live/{{ nginx_front.cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_front.cert_name }}/privkey.pem;

    client_max_body_size 2m;
    proxy_buffering on;

    # Block internal endpoints from public access (ADR-017 / SEC1-b)
    location /internal/ {
        return 404;
    }

    location / {
        proxy_pass http://winkey_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # Overwrite (not append): Traefik trusts these headers only from this hop
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $winkey_connection;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Realtime service WebSocket endpoint (C2): idle timeout >= 120s (1h)
    location /v1/realtime {
        proxy_pass http://winkey_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $winkey_connection;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# 2. S3 Object Storage endpoint (Garage): presigned PUT upload parts and downloads
server {
    listen 443 ssl http2;
    server_name s3.winkey.vn;

    ssl_certificate /etc/letsencrypt/live/{{ nginx_front.cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_front.cert_name }}/privkey.pem;

    # Presigned multipart upload parts (≥ 64 MiB); stream directly to avoid filling host disk
    client_max_body_size 64m;
    proxy_request_buffering off;
    proxy_buffering off;

    # Long timeouts for large multipart chunk uploads
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location / {
        proxy_pass http://winkey_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host $host;

        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $winkey_connection;
    }
}

# 3. Media delivery: HLS segments and video playback with host proxy_cache (ADR-005, ADR-014, ADR-017)
server {
    listen 443 ssl http2;
    server_name media.winkey.vn;

    ssl_certificate /etc/letsencrypt/live/{{ nginx_front.cert_name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ nginx_front.cert_name }}/privkey.pem;

    client_max_body_size 2m;
    include /etc/nginx/winkey-media-secret.conf;

    # 1. Signed media URLs: for non-public videos (owner, moderator, admin)
    location ~ "^/s/(?<exp>\d+)/(?<sig>[A-Za-z0-9_-]+)/(?<path>v/(?<vid>[0-9a-f-]{36})/.+)$" {
        secure_link $sig,$exp;
        secure_link_md5 "$exp/v/$vid/ $media_link_secret";
        if ($secure_link = "")  { return 403; }
        if ($secure_link = "0") { return 410; }
        rewrite ^ /$path break;

        proxy_pass http://winkey_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host winkey-media.{{ root_domain | default('winkey.vn') }};

        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Edge caching on host disk (ADR-005, ADR-014)
        # Buffering must stay ON for proxy_cache to store responses
        proxy_buffering on;
        proxy_cache winkey_media;
        proxy_cache_key "$scheme$request_method$host$uri";
        proxy_cache_valid 200 206 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_revalidate on;
        proxy_ignore_headers X-Accel-Expires;

        # Range request support for seeking video segments
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Access-Control-Allow-Origin * always;
        add_header X-Content-Type-Options nosniff always;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # 2. Plain media URLs: checked against video-svc /internal/media-access/{vid}
    location ~ "^/v/(?<vid>[0-9a-f-]{36})/" {
        set $auth_vid $vid;
        auth_request /_media_access;

        proxy_pass http://winkey_traefik;
        proxy_http_version 1.1;
        proxy_set_header Host winkey-media.{{ root_domain | default('winkey.vn') }};

        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto https;

        # Edge caching on host disk (ADR-005, ADR-014)
        # Buffering must stay ON for proxy_cache to store responses
        proxy_buffering on;
        proxy_cache winkey_media;
        proxy_cache_key "$scheme$request_method$host$uri";
        proxy_cache_valid 200 206 30d;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_revalidate on;
        proxy_ignore_headers X-Accel-Expires;

        # Range request support for seeking video segments
        proxy_set_header Range $http_range;
        proxy_set_header If-Range $http_if_range;

        proxy_hide_header Access-Control-Allow-Origin;
        add_header X-Cache-Status $upstream_cache_status;
        add_header Access-Control-Allow-Origin * always;
        add_header X-Content-Type-Options nosniff always;

        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    # Internal subrequest for media authorization (cached 30s per vid)
    location = /_media_access {
        internal;
        proxy_pass http://winkey_traefik/internal/media-access/$auth_vid;
        proxy_set_header Host media-auth.internal;
        proxy_set_header X-Real-IP {{ tailscale_ipv4 }};
        proxy_set_header X-Forwarded-For {{ tailscale_ipv4 }};
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_cache winkey_media_auth;
        proxy_cache_key $auth_vid;
        proxy_cache_valid 204 403 30s;
    }

    # Anything else under media.winkey.vn -> 404 (ADR-017)
    location / {
        return 404;
    }
}
{% endif %}
