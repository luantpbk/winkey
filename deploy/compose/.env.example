# Winkey Local Dev Environment (.env)

# Bind IP: 0.0.0.0 for LAN access (default) or LAN IP (e.g. 192.168.1.4 on gpu-01)
DEV_BIND_IP=0.0.0.0

# Database (PostgreSQL 17)
POSTGRES_DB=winkey
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
MIGRATOR_USER=winkey_migrator
MIGRATOR_PASSWORD=winkey_migrator
AUTH_SVC_USER=auth_svc
AUTH_SVC_PASSWORD=auth_svc
MEDIA_SVC_USER=media_svc
MEDIA_SVC_PASSWORD=media_svc
DATABASE_URL=postgres://winkey_migrator:winkey_migrator@postgres:5432/winkey?sslmode=disable

# NATS JetStream
NATS_URL=nats://nats:4222

# Valkey (Redis 8.x compatible)
VALKEY_URL=redis://valkey:6379

# Garage Object Storage
GARAGE_S3_REGION=garage
GARAGE_S3_ENDPOINT=http://localhost:3900
GARAGE_S3_PUBLIC_ENDPOINT=http://localhost:3900
GARAGE_RPC_SECRET=1799bccfd7411eddcf9ebd316bc1f5287ad12a68094e1c6ac6abde7e6feae1ec
GARAGE_DEV_KEY_NAME=winkey-dev

# Gateway & Ports
GATEWAY_PORT=8080
MEDIA_CACHE_PORT=8081
POSTGRES_PORT=5432
VALKEY_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
GARAGE_S3_PORT=3900
GARAGE_WEB_PORT=3902
